# IDE files
.idea/
.vscode/
*.swp
*.swo

# OS files
Thumbs.db
.DS_Store

# Mobile/Flutter specific (handled by subfolder .gitignore, but safe to add here)
**/build/
**/.dart_tool/
**/.pub-cache/
**/.packages
**/ios/Flutter/Generated.xcconfig
**/android/local.properties

# Node / JS
**/node_modules/
**/dist/
**/npm-debug.log*

# Python specific
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/.env
**/.venv/
**/venv/
**/env/

# Data/Models (if they are large)
**/faces_registry.db
**/haarcascades/

# Face recognition data — dữ liệu cá nhân (ảnh khuôn mặt), không nên commit
ESP32CAM/members.db
ESP32CAM/img/
ESP32CAM/temp/

# iOS build artifacts
FLUTTER/*.zip
FLUTTER/ios-*/
FLUTTER/ios-release-*/
FLUTTER/ios-sideload-*/

# Claude settings
.claude/
